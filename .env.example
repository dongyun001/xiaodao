# 复制为 .env 后填写；所有密钥、密码、webhook、token 只放本地 .env，不提交 Git。
# 本文件只放占位值，不能填写真实凭据。

# 应用
APP_NAME=辅导员 AI 问答机器人
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# PostgreSQL（步骤 1 不连接数据库；后续步骤使用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=counselor_bot
DB_USER=counselor
DB_PASSWORD=

# LLM（DeepSeek，OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
INTENT_DEEPSEEK_TIMEOUT=10
COMFORT_DEEPSEEK_TIMEOUT=20

# Embedding（任意 OpenAI 兼容服务：SiliconFlow / 本地 Ollama / 自建服务）
# DeepSeek 平台没有 embedding 接口，不要指向它。
# 本地 Ollama 示例：EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#                  EMBEDDING_MODEL=qwen3-embedding:4b
#                  EMBEDDING_DIMENSIONS=1024   # 该模型原生 2560 维，靠 MRL 截断
#                  EMBEDDING_API_KEY=<任意非空占位>   # Ollama 不校验，但不能留空
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=30
# 仅 MRL 模型可用；留空按模型原生维度。必须与 VECTOR_DIMENSION 一致。
EMBEDDING_DIMENSIONS=

# 向量
VECTOR_DIMENSION=1024

# 微信
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENCODING_AES_KEY=

# 辅导员联系方式（用于转介话术）
COUNSELOR_CONTACT=
COUNSELOR_OFFICE_HOURS=工作日 8:30-17:30

# 检索阈值
RETRIEVAL_MIN_SCORE=0.55
RETRIEVAL_TOP_K=5
NOTICE_RETRIEVAL_MIN_SCORE=0.55
NOTICE_RETRIEVAL_TOP_K=5

# 官网通知采集（示例：南阳师范学院官网「通知公告」栏目；换站点时需改解析规则）
NOTICE_FETCH_BASE_URL=https://www.nynu.edu.cn/
NOTICE_FETCH_PAGES=3
NOTICE_FETCH_TIMEOUT_MS=15000
NOTICE_FETCH_CRON=0 */6 * * *

# 钉钉告警（留空则关闭）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
ALERT_DEDUP_MINUTES=10

# 管理后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
